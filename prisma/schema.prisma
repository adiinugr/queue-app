generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  SKIPPED
}

enum CounterType {
  OPERATOR
  VERIFIKATOR
}

enum QueueType {
  OPERATOR
  VERIFIKATOR
}

model Setting {
  id                String   @id @default("default")
  dailyQueueLimit   Int      @default(200)
  startNumber       Int      @default(1)
  resetQueueDaily   Boolean  @default(true)
  allowSimultaneous Boolean  @default(false)
  videoUrl          String?  @default("https://www.youtube.com/embed/jAQvxW2l-Pg")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Counter {
  id           String      @id @default(uuid())
  name         String
  number       Int
  counterType  CounterType @default(OPERATOR)
  isActive     Boolean     @default(true)
  currentQueue Queue?      @relation("CurrentQueue")
  queueHistory Queue[]     @relation("QueueHistory")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Queue {
  id               String      @id @default(uuid())
  number           Int
  queueType        QueueType   @default(OPERATOR)
  status           QueueStatus @default(WAITING)
  servedBy         Counter?    @relation("CurrentQueue", fields: [counterServingId], references: [id])
  counterServingId String?     @unique
  historyCounters  Counter[]   @relation("QueueHistory")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  date             DateTime    @default(now())
}
